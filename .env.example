# PostgreSQL (Neon), en local y en producción. Mismo motor en ambos lados a
# propósito: las migraciones de Prisma son específicas del proveedor y no son
# portables entre SQLite y Postgres.
#
# Copia este archivo a .env y pon tu cadena real. .env está en .gitignore.

# --- Local ---------------------------------------------------------------
# Usa la cadena SIN pooler (en Neon: DATABASE_URL_UNPOOLED, el host va sin
# "-pooler"). `prisma migrate` necesita bloqueos de sesión que pgbouncer no
# garantiza.
#
# sslmode=verify-full y no `require`: hoy `pg` trata `require` como verify-full,
# pero en pg v9 adoptará la semántica de libpq, más débil. Dejarlo explícito
# evita que la seguridad baje sola en una actualización.
DATABASE_URL="postgresql://usuario:password@ep-algo.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# --- Producción (Vercel) -------------------------------------------------
# NO va en este archivo: se configura en Settings -> Environment Variables.
# Ahí sí se usa la cadena CON pooler (el host lleva "-pooler"), porque las
# funciones serverless abren muchas conexiones cortas.
# DATABASE_URL="postgresql://usuario:password@ep-algo-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"
