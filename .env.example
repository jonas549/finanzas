# Local (SQLite). Ruta relativa a la raíz del proyecto.
DATABASE_URL="file:./prisma/dev.db"

# Vercel (Postgres). Al cambiar:
#   1. prisma/schema.prisma -> provider = "postgresql"
#   2. npm install @prisma/adapter-pg pg
#   3. lib/prisma.ts -> PrismaPg({ connectionString: process.env.DATABASE_URL })
#   4. npx prisma migrate dev --name init-postgres
# DATABASE_URL="postgresql://usuario:password@host:5432/finanzas?sslmode=require"
