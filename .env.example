# PostgreSQL, en local y en producción (mismo motor en ambos lados a propósito:
# las migraciones de Prisma son específicas del proveedor y no son portables).
#
# Copia este archivo a .env y pon tu cadena real. .env está en .gitignore.

# --- Local ---------------------------------------------------------------
# Opción A: Postgres en Docker
#   docker run --name finanzas-db -e POSTGRES_PASSWORD=finanzas \
#     -e POSTGRES_DB=finanzas -p 5432:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:finanzas@localhost:5432/finanzas?schema=public"

# Opción B: una segunda base gratuita en el mismo proveedor que producción.
# DATABASE_URL="postgresql://usuario:password@host/finanzas_dev?sslmode=require"

# --- Producción (Vercel) -------------------------------------------------
# NO va en este archivo: se configura como variable de entorno en el panel de
# Vercel. Si usas Vercel Postgres o Neon, la cadena la genera el proveedor y
# suele terminar en ?sslmode=require
# DATABASE_URL="postgresql://usuario:password@host/finanzas?sslmode=require"
